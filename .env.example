# Set automatically by Vercel on every deployment; do not set it yourself.
# Locally, it's absent and the app falls back to a "local-dev" marker
# (see lib/deployed-commit.ts).
VERCEL_GIT_COMMIT_SHA=

# --- Supabase (Sprint 2) ---

# Public. Safe in client bundles. From the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=

# Public. Safe in client bundles -- RLS is what protects data, not this
# key being secret. From the Supabase project settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security entirely. Server-only: read only from
# lib/supabase/admin.ts, used only inside app/api/health/db/route.ts (a
# Route Handler, never bundled to the client). Never prefix this
# NEXT_PUBLIC_, never import lib/supabase/admin.ts from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Sprint 17) ---

# SECRET. Bills a real account on every horoscope generation request, on a
# public, unauthenticated button -- the OpenAI account's own spend cap is
# the control, not this key being secret. Server-only: read only from
# lib/llm/horoscope.ts, only ever reached via app/reading/[id]/actions.ts
# (a "use server" action, never bundled to the client). Never prefix this
# NEXT_PUBLIC_.
OPENAI_API_KEY=

# Public-safe (no key material), but still server-read only via
# lib/llm/generate.ts. Kill switch for horoscope generation: absent, or
# any value other than exactly "false" (case-insensitive), means enabled.
# There is no "safe default off" here on purpose -- an absent/misconfigured
# flag must not silently ship the feature disabled.
HOROSCOPE_ENABLED=
